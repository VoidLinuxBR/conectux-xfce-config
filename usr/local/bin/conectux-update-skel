set -eu

sh_trap_int() {
	echo
	log_warn "Execução interrompida pelo usuário."
	exit 130
}
trap sh_trap_int INT

declare REMOTE_INI=50
declare REMOTE_FIM=60
declare REMOTE_IP='100.119.111'
declare REMOTE_PORT='22'
declare REMOTE_USER='aluno'
declare senha='senha'
#
declare QUIET=false
declare PROCESS_ALL=false
declare REBOOT=false
#
declare -a HOSTS_SUCCESS=()
declare -a HOSTS_OFFLINE=()
declare -a HOSTS_FAILED=()

usage() {
	cat <<EOF
${cyan}${APPDESC}${rst}

Uso: $APP [Opções]

Opções:
  -a, --all                Processa todos os hosts (${yellow}${REMOTE_IP}.${REMOTE_INI}-${REMOTE_IP}.${REMOTE_FIM}${rst})
  -i, --remote-ini ${red}<NUM>${rst}   Primeiro host do intervalo
  -f, --remote-fim ${red}<NUM>${rst}   Último host do intervalo
  -q, --quiet              Oculta a saída dos comandos
  -r, --reboot             Reinicia o host remoto após finalizar
  -V, --version            Mostra a versão e sai
  -h, --help               Mostra esta ajuda

Exemplos:
  $APP -a
  $APP -a -q
  $APP -i 50 -f 55
  $APP --remote-ini 50 --remote-fim 55
  $APP -i 50 -f 55 --quiet
  $APP -i 50 -f 50 --quiet --reboot
EOF
}

if (($# == 0)); then
	usage
	exit 0
fi

while (($#)); do
	case "$1" in
	-V | --version)
		sh_version
		exit 0
		;;

	-r | --reboot)
		REBOOT=true
		shift
		;;

	-a | --all)
		PROCESS_ALL=true
		shift
		;;

	-i | --remote-ini)
		if (($# < 2)); then
			echo "Opção $1 requer um valor." >&2
			echo >&2
			usage >&2
			exit 1
		fi
		REMOTE_INI="$2"
		shift 2
		;;

	-f | --remote-fim)
		if (($# < 2)); then
			echo "Opção $1 requer um valor." >&2
			echo >&2
			usage >&2
			exit 1
		fi
		REMOTE_FIM="$2"
		shift 2
		;;

	-q | --quiet)
		QUIET=true
		shift
		;;

	-h | --help)
		usage
		exit 0
		;;

	*)
		echo "Opção inválida: $1" >&2
		echo >&2
		usage >&2
		exit 1
		;;
	esac
done

if "$PROCESS_ALL"; then
	REMOTE_INI=50
	REMOTE_FIM=60
fi

if ! [[ $REMOTE_INI =~ ^[0-9]+$ && $REMOTE_FIM =~ ^[0-9]+$ ]]; then
	echo "REMOTE_INI e REMOTE_FIM devem ser números inteiros." >&2
	exit 1
fi

if ((REMOTE_INI > REMOTE_FIM)); then
	echo "REMOTE_INI não pode ser maior que REMOTE_FIM." >&2
	exit 1
fi

sh_msg() {
	$QUIET || echo "$@":
}

sh_run_cmd() {
	printf '%s Running:' "$INFO" >&2
	printf ' %q' "$@" >&2
	printf ' ' >&2

	if "$QUIET"; then
		local output status
		output=$(mktemp)

		if "$@" >"$output" 2>&1; then
			rm -f "$output"
			printf '%s\n' "$TICK" >&2
			return 0
		else
			status=$?
			printf '%s\n' "$CROSS" >&2
			cat "$output" >&2
			rm -f "$output"
			return "$status"
		fi
	else
		if "$@"; then
			printf '%s\n' "$TICK" >&2
			return 0
		else
			status=$?
			printf '%s\n' "$CROSS" >&2
			return "$status"
		fi
	fi
}

sh_connect_remote_upgrade() {
	sh_msg "Executando os comandos em ${usuario}@${ip}:${porta}..."

	SSHPASS="$senha" sshpass -e ssh \
		-o StrictHostKeyChecking=accept-new \
		-p "$porta" \
		"${usuario}@${ip}" \
		bash -s -- "$usuario" "$ip" "$porta" "$QUIET" "$REBOOT" <<'REMOTE'
set -e
export TERM=${TERM:-xterm-256color}

user=$1
nip=$2
port=$3
quiet=$4
reboot=$5

black='\033[1;30m'
red='\033[1;38;5;196m'
green='\033[1;32m'
yellow='\033[1;33m'
blue='\033[38;5;27m'
cyan='\033[1;36m'
reset='\033[0m'

: "${COL_NC="$reset"}"
: "${COL_LIGHT_GREEN="$green"}"
: "${COL_LIGHT_RED="$red"}"
: "${DONE="${COL_LIGHT_GREEN} done!${COL_NC}"}"
: "${OVER='\r\033[K'}"
: "${DOTPREFIX="  ${black}::${reset} "}"
: "${clrkey="$reset"}"
: "${TICK="${clrkey}[${green}✓${clrkey}]${reset}"}"
: "${CROSS="${clrkey}[${red}✗${clrkey}]${reset}"}"
: "${MID="${clrkey}[${red}✗${green}✓${clrkey}]${reset}"}"
: "${WARN="${clrkey}[${yellow}⚠${clrkey}]${reset}"}"
: "${INFO="${cyan}[⛭]${reset}"}"

    replicate() {
      local char="${1:-#}"
      local nsize="${2:-$(tput cols)}"
      # Gera linha com substituição direta sem forks extras
      printf -v _line "%*s" "$nsize" ""
      printf '%b\n' "${blue}${_line// /$char}${reset}"
    }

run_cmd() {
	local output status cmd cols

	cols="${COLUMNS:-$(tput cols 2>/dev/null || printf '80')}"

	printf -v cmd '%q ' "$@"
	cmd="${cmd% }"

	printf '%b Running on remote %b%s%b: %s' \
		"$INFO" \
		"$yellow" \
		"$nip" \
		"$reset" \
		"$cmd" >&2

	if [[ "$quiet" == true ]]; then
		output=$(mktemp)

		if "$@" >"$output" 2>&1; then
			status=0
		else
			status=$?
		fi

		# Coluna final do terminal
		printf '\033[1;%dG%b\n' \
			"$((cols - 3))" \
			"$([[ $status -eq 0 ]] && printf '%b' "$TICK" || printf '%b' "$CROSS")" >&2

		if ((status != 0)); then
			cat "$output" >&2
		fi

		rm -f "$output"
		return "$status"
	fi

	if "$@"; then
		status=0
	else
		status=$?
	fi

	# Coluna final do terminal
	printf '\033[1;%dG%b\n' \
		"$((cols - 3))" \
		"$([[ $status -eq 0 ]] && printf '%b' "$TICK" || printf '%b' "$CROSS")" >&2

	return "$status"
}

{
	echo 'repository=https://repo-fastly.voidlinux.org/current'
	echo '#repository=https://repo-fastly.voidlinux.org/current/nonfree'
	echo '#repository=https://repo-fastly.voidlinux.org/current/multilib'
	echo '#repository=https://repo-fastly.voidlinux.org/current/multilib/nonfree'
} | run_cmd sudo tee /etc/xbps.d/00-repository-main.conf

run_cmd sudo mkdir -p /etc/ssh/sshd_config.d/
echo "Port $port" | run_cmd sudo tee /etc/ssh/sshd_config.d/${port}-custom.conf

run_cmd vservice restart lightdm
run_cmd vinstall -Syuf
run_cmd vinstall -fy conectux-xfce-config

cd -- "/home/$user" || exit 1
[[ "$PWD" == "/home/$user" ]] || exit 1

# Remove todo o conteúdo, inclusive arquivos ocultos, exceto '.' e '..'.
if [[ "$quiet" == true ]]; then
  rm -rf -- .[!.]* ..?* * >/dev/null 2>&1
else
  rm -rfv -- .[!.]* ..?* *
fi
run_cmd cp -Rpa /etc/skel/. .
run_cmd ls -la
#
run_cmd voidbr-vkpurge rm all
run_cmd voidbr-low-ram-optimizer --install
run_cmd voidbr-var-log-cleaner
run_cmd vinstall -Scc
run_cmd vservice add sshd
run_cmd vservice add epoptes-client
run_cmd vservice add tailscaled
#
{
    echo "[Seat:*]"
    echo "autologin-user=$user"
    echo "autologin-session=xfce"
} | run_cmd sudo tee /etc/lightdm/lightdm.conf.d/00-autologin.conf
#
run_cmd vinstall -fy voidbr-limine-config
run_cmd sudo voidbr-manager-bootloader --disk /dev/sda --bootloader limine --mode bios --yes
#
run_cmd vservice restart lightdm
#
REMOTE
}

sh_connect_remote_ssh_copy() {
	sh_msg "Executando ssh-copy-id em ${usuario}@${ip}:${porta}..."

	SSHPASS="$senha" sh_run_cmd sshpass -e ssh-copy-id \
		-o StrictHostKeyChecking=accept-new \
		-p "$porta" \
		"$usuario@$ip"
}

sh_connect_remote_reboot() {
	sh_msg "Reiniciando ${usuario}@${ip}:${porta}..."

	SSHPASS="$senha" sh_run_cmd sshpass -e ssh \
		-o StrictHostKeyChecking=accept-new \
		-p "$porta" \
		"$usuario@$ip" \
		sudo reboot
}

sh_is_online() {
	local ip="$1"
	ping -c1 -W1 "$ip" >/dev/null 2>&1
}

for ((machine = REMOTE_INI; machine <= REMOTE_FIM; machine++)); do
	ip="${REMOTE_IP}.${machine}"
	usuario="${REMOTE_USER}${machine}"
	porta="${REMOTE_PORT}${machine}"

	if sh_is_online "$ip"; then
		if ! sh_connect_remote_upgrade; then
			log_err "${cyan}Falha na execução: ${red}$ip${rst}"
			HOSTS_FAILED+=("$ip")
			continue
		fi

		if ! sh_connect_remote_ssh_copy; then
			log_err "${cyan}Falha no ssh-copy-id: ${red}$ip${rst}"
			HOSTS_FAILED+=("$ip")
			continue
		fi

		if "$REBOOT"; then
			sh_connect_remote_reboot
		fi

		HOSTS_SUCCESS+=("$ip")
		log_ok "Host atualizado com sucesso: ${green}${ip}${rst}"
		echo
	else
		log_err "${cyan}Host offline: ${red}$ip${rst}"
		HOSTS_OFFLINE+=("$ip")
	fi
done

if ((${#HOSTS_OFFLINE[@]})); then
	log_err "Hosts offline:"
	for host in "${HOSTS_OFFLINE[@]}"; do
		log_err_tab "  ${red}$host${rst}"
	done
fi

if ((${#HOSTS_FAILED[@]})); then
	log_err "Hosts com falha de execução:"
	for host in "${HOSTS_FAILED[@]}"; do
		log_err_tab "  ${red}$host${rst}"
	done
fi

if ((${#HOSTS_SUCCESS[@]})); then
	log_ok "Hosts com sucesso de execução:"
	for host in "${HOSTS_SUCCESS[@]}"; do
		log_ok_tab "  ${green}$host${rst}"
	done
fi
